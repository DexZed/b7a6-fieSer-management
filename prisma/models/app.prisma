// System Domain Models

model Skill {
  id    Int               @id @default(autoincrement())
  name  String            @unique
  techs TechnicianSkill[]

  @@map("skills")
}

model TechnicianSkill {
  technicianId String
  skillId      Int

  technician User  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  skill      Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([technicianId, skillId])
  @@map("technician_skills")
}

model ServiceRequest {
  id          Int           @id @default(autoincrement())
  customerId  String
  title       String
  description String
  address     String
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  customer  User       @relation("CustomerRequests", fields: [customerId], references: [id])
  workOrder WorkOrder?

  @@index([customerId])
  @@index([status])
  @@map("service_requests")
}

model WorkOrder {
  id              Int             @id @default(autoincrement())
  requestId       Int             @unique
  technicianId    String
  dispatcherId    String
  status          WorkOrderStatus @default(ASSIGNED)
  scheduledStart  DateTime
  scheduledEnd    DateTime
  completionNotes String?
  createdAt       DateTime        @default(now())

  serviceRequest ServiceRequest @relation(fields: [requestId], references: [id])
  technician     User           @relation("AssignedTechnician", fields: [technicianId], references: [id])
  dispatcher     User           @relation("DispatchedBy", fields: [dispatcherId], references: [id])
  invoice        Invoice?
  feedback       Feedback?

  // Indexing for double-booking collision checks
  @@index([technicianId, scheduledStart, scheduledEnd])
  @@index([status])
  @@map("work_orders")
}

model Invoice {
  id          Int           @id @default(autoincrement())
  workOrderId Int           @unique
  amount      Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(UNPAID)
  createdAt   DateTime      @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  payments  Payment[]

  @@index([status])
  @@map("invoices")
}

model Payment {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  amountPaid    Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("CREDIT_CARD")
  paidAt        DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payments")
}

model Feedback {
  id          Int      @id @default(autoincrement())
  workOrderId Int      @unique
  rating      Int
  comments    String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@map("feedback")
}
