// use prisma-next

enum Role {
  CUSTOMER
  TECHNICIAN
  DISPATCHER
  FINANCE
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkOrderStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime 

  // Relations
  skills                  TechnicianSkill[]
  customerServiceRequests ServiceRequest[]  @relation("CustomerRequests")
  assignedWorkOrders      WorkOrder[]       @relation("AssignedTechnician")
  dispatchedWorkOrders    WorkOrder[]       @relation("DispatchedBy")

  @@map("users")
}

model Skill {
  id   Int               @id @default(autoincrement())
  name String            @unique
  tech TechnicianSkill[]

  @@map("skills")
}

model TechnicianSkill {
  technicianId Int
  skillId      Int

  technician User  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  skill      Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([technicianId, skillId])
  @@map("technician_skills")
}

model ServiceRequest {
  id          Int           @id @default(autoincrement())
  customerId  Int
  title       String
  description String
  address     String
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  customer  User       @relation("CustomerRequests", fields: [customerId], references: [id])
  workOrder WorkOrder?

  @@map("service_requests")
}

model WorkOrder {
  id              Int             @id @default(autoincrement())
  requestId       Int             @unique
  technicianId    Int
  dispatcherId    Int
  status          WorkOrderStatus @default(ASSIGNED)
  scheduledStart  DateTime
  scheduledEnd    DateTime
  completionNotes String?
  createdAt       DateTime        @default(now())

  serviceRequest ServiceRequest @relation(fields: [requestId], references: [id])
  technician     User           @relation("AssignedTechnician", fields: [technicianId], references: [id])
  dispatcher     User           @relation("DispatchedBy", fields: [dispatcherId], references: [id])
  invoice        Invoice?
  feedback       Feedback?

  @@map("work_orders")
}

model Invoice {
  id          Int           @id @default(autoincrement())
  workOrderId Int           @unique
  amount      Decimal       
  status      InvoiceStatus @default(UNPAID)
  createdAt   DateTime      @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  payments  Payment[]

  @@map("invoices")
}

model Payment {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  amountPaid    Decimal
  paymentMethod String   @default("CREDIT_CARD")
  paidAt        DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model Feedback {
  id          Int      @id @default(autoincrement())
  workOrderId Int      @unique
  rating      Int
  comments    String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@map("feedback")
}